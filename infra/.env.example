# Sample environment configuration for DocFlow

PROJECT_NAME="DocFlow API"
ENVIRONMENT=development

# Database (PostgreSQL for Docker, SQLite for local standalone testing)
DATABASE_URL=postgresql+asyncpg://docflow_user:docflow_password_demo@localhost:5432/docflow_db
# DATABASE_URL=sqlite+aiosqlite:///./docflow.db

# Redis for OAuth PKCE state cache
REDIS_URL=redis://localhost:6379/0

# Provider Interface Selection (mock | real | gemini | claude)
DIGILOCKER_PROVIDER=mock
LLM_PROVIDER=mock
OCR_PROVIDER=mock
STORAGE_PROVIDER=mock

# Vault Secret (Used for client/device vault reference hashes)
VAULT_SECRET_KEY=demo-super-secret-vault-key-32b!

# Optional LLM credentials (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
