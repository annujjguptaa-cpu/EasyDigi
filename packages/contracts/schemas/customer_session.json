{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomerSession",
  "type": "object",
  "required": ["session_id", "verification_request_id", "status", "expires_at"],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "verification_request_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["INITIATED", "CONSENTED", "DOCUMENTS_UPLOADED", "COMPLETED", "EXPIRED"] },
    "expires_at": { "type": "string", "format": "date-time" },
    "ip_address": { "type": "string" },
    "user_agent": { "type": "string" }
  },
  "additionalProperties": false
}
